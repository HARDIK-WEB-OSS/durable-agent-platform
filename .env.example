POSTGRES_USER=dap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dap
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

WORKER_LEASE_SECONDS=10
WORKER_POLL_SECONDS=0.5
RETRY_BASE_SECONDS=0.5
RETRY_CAP_SECONDS=30

# Model strings use LiteLLM format: <provider>/<model>. cheap and mid run locally on Ollama;
# strong is a hosted model. Any arm can be swapped by setting a model string plus its *_API_KEY.
OLLAMA_API_BASE=http://localhost:11434
LOCAL_NUM_CTX=4096
CHEAP_MODEL=ollama_chat/qwen2.5:1.5b
CHEAP_API_KEY=
MID_MODEL=ollama_chat/qwen2.5:3b
MID_API_KEY=
# Strong arm is hosted (paid). Pick a LiteLLM provider/model string, e.g. groq/<model>,
# together_ai/<model>, deepinfra/<model>, openrouter/<model>, and put its key below.
STRONG_MODEL=
STRONG_API_KEY=
# Client-side limit for each hosted arm, per process (each worker process has its own).
LLM_HOSTED_RPM=30
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
# USD per 1M tokens as [input, output]. Needed when LiteLLM's table lacks the model or its price
# differs from the provider's current price page, e.g. {"groq/<model>": [0.05, 0.08]}
LLM_PRICE_OVERRIDES={}
# Hosted model whose real price anchors shadow prices of local models (scaled by parameter count)
LLM_SHADOW_ANCHOR=deepinfra/Qwen/Qwen2.5-7B-Instruct

# Agent (Phase 4)
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=900
AGENT_MAX_TOKENS=512
AGENT_MAX_OBSERVATION_CHARS=2000

# search_docs: embeddings from Ollama (ollama pull nomic-embed-text); 768-dim, fixed by migration 0004
EMBEDDING_MODEL=nomic-embed-text
SEARCH_TOP_K=4

# sql_query: a run's sql_db must be a file inside this directory; opened read-only
SQL_DATA_DIR=data/sql
SQL_TIMEOUT_SECONDS=5

# python_exec: hardened Docker sandbox. Set false on hosts without Docker; the tool is then
# not offered to the model. The image must be pinned by digest.
PYTHON_EXEC_ENABLED=true
SANDBOX_IMAGE=python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
SANDBOX_TIMEOUT_SECONDS=10
